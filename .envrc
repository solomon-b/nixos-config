use flake

export PATH="$HOME/.local/bin:$PATH"
export GRAFANA_TOKEN="$(sops --decrypt --extract '["grafana-claude-token"]' secrets.yaml 2>/dev/null)"
export GRAFANA_URL="http://grafana.service.home.arpa"
export FORGEJO_TOKEN="$(sops --decrypt --extract '["forgejo-claude-key"]' secrets.yaml 2>/dev/null)"
export FORGEJO_URL="http://forgejo.service.home.arpa"

{
  "global": {
    "show_in_menu_bar": false
  },
  "profiles": [
    {
      "name": "Default profile",
      "selected": true,
      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock → Control (hold) / Escape (tap)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [ { "key_code": "left_control" } ],
                "to_if_alone": [ { "key_code": "escape" } ]
              }
            ]
          },
          {
            "description": "Tab → Option (hold) / Tab (tap)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "tab",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [ { "key_code": "left_option" } ],
                "to_if_alone": [ { "key_code": "tab" } ]
              }
            ]
          },
          {
            "description": "Backslash → Option (hold) / Backslash (tap)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "backslash",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [ { "key_code": "left_option" } ],
                "to_if_alone": [ { "key_code": "backslash" } ]
              }
            ]
          },
          {
            "description": "Ctrl+Left/Right → word navigation, Ctrl+Backspace → delete word (like Linux)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "left_arrow",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "left_arrow", "modifiers": ["left_option"] } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "right_arrow",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "right_arrow", "modifiers": ["left_option"] } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "left_arrow",
                  "modifiers": { "mandatory": ["left_control", "left_shift"], "optional": [] }
                },
                "to": [ { "key_code": "left_arrow", "modifiers": ["left_option", "left_shift"] } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "right_arrow",
                  "modifiers": { "mandatory": ["left_control", "left_shift"], "optional": [] }
                },
                "to": [ { "key_code": "right_arrow", "modifiers": ["left_option", "left_shift"] } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "delete_or_backspace",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "delete_or_backspace", "modifiers": ["left_option"] } ]
              }
            ]
          },
          {
            "description": "Ctrl+L / Ctrl+T / Ctrl+W / Ctrl+Shift+T / Ctrl+[ / Ctrl+] → browser shortcuts",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "l", "modifiers": ["left_command"] } ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Safari$",
                      "^com\\.google\\.Chrome$",
                      "^org\\.mozilla\\.firefox$",
                      "^company\\.thebrowser\\.Browser$",
                      "^com\\.brave\\.Browser$",
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "t",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "t", "modifiers": ["left_command"] } ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Safari$",
                      "^com\\.google\\.Chrome$",
                      "^org\\.mozilla\\.firefox$",
                      "^company\\.thebrowser\\.Browser$",
                      "^com\\.brave\\.Browser$",
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "w",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "w", "modifiers": ["left_command"] } ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Safari$",
                      "^com\\.google\\.Chrome$",
                      "^org\\.mozilla\\.firefox$",
                      "^company\\.thebrowser\\.Browser$",
                      "^com\\.brave\\.Browser$",
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "t",
                  "modifiers": { "mandatory": ["left_control", "left_shift"], "optional": [] }
                },
                "to": [ { "key_code": "t", "modifiers": ["left_command", "left_shift"] } ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Safari$",
                      "^com\\.google\\.Chrome$",
                      "^org\\.mozilla\\.firefox$",
                      "^company\\.thebrowser\\.Browser$",
                      "^com\\.brave\\.Browser$",
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "open_bracket",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "open_bracket", "modifiers": ["left_command"] } ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Safari$",
                      "^com\\.google\\.Chrome$",
                      "^org\\.mozilla\\.firefox$",
                      "^company\\.thebrowser\\.Browser$",
                      "^com\\.brave\\.Browser$",
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "close_bracket",
                  "modifiers": { "mandatory": ["left_control"], "optional": [] }
                },
                "to": [ { "key_code": "close_bracket", "modifiers": ["left_command"] } ],
                "conditions": [
                  {
                    "type": "frontmost_application_if",
                    "bundle_identifiers": [
                      "^com\\.apple\\.Safari$",
                      "^com\\.google\\.Chrome$",
                      "^org\\.mozilla\\.firefox$",
                      "^company\\.thebrowser\\.Browser$",
                      "^com\\.brave\\.Browser$",
                      "^com\\.microsoft\\.edgemac$"
                    ]
                  }
                ]
              }
            ]
          },
          {
            "description": "Option+1-5 → focus Emacs / Ghostty / Chrome / Slack / Linear",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "1",
                  "modifiers": { "mandatory": ["left_option"], "optional": [] }
                },
                "to": [ { "shell_command": "open -a Emacs" } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "2",
                  "modifiers": { "mandatory": ["left_option"], "optional": [] }
                },
                "to": [ { "shell_command": "open -a Ghostty" } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "3",
                  "modifiers": { "mandatory": ["left_option"], "optional": [] }
                },
                "to": [ { "shell_command": "open -a \"Google Chrome\"" } ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "4",
                  "modifiers": { "mandatory": ["left_option"], "optional": [] }
                },
                "to": [ { "shell_command": "open -a Slack" } ]
              }
            ]
          },
          {
            "description": "Option+P → Spotlight",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "p",
                  "modifiers": { "mandatory": ["left_option"], "optional": [] }
                },
                "to": [ { "key_code": "spacebar", "modifiers": ["left_command"] } ]
              }
            ]
          }
        ]
      },
      "virtual_hid_keyboard": {
        "keyboard_type_v2": "ansi"
      }
    }
  ]
}
